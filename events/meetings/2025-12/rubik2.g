##############################################################################
##
#X  Rubik's cube 2x2x2
##
Print( "  Rubik's 2x2x2 cube, as a perm. group on 21 points: \n" );
Print( "  -------------------------------------------------- \n" );
Print( "           +--------+                                \n" );
Print( "           |  1   2 |                                \n" );
Print( "           |  3   4 |                                \n" );
Print( "  +--------+--------+--------+--------+              \n" );
Print( "  |  5   6 |  8   9 | 12  13 | 16  17 |              \n" );
Print( "  |  *   7 | 10  11 | 14  15 | 18   * |              \n" );
Print( "  +--------+--------+--------+--------+              \n" );
Print( "           | 19  20 |                                \n" );
Print( "           |  *  21 |                                \n" );
Print( "           +--------+                                \n" );

top    := ( 1, 2, 4, 3)( 5,16,12, 8)( 6,17,13, 9);
front  := ( 8, 9,11,10)( 3,12,20, 7)( 4,14,19, 6);
right  := ( 2,18,20, 9)( 4,16,21,11)(12,13,15,14);

cube := Group( top, front, right );

Print( "\n" );
Print( "  cube: group generated by rotations of three faces\n" );
Print( "\n" );


